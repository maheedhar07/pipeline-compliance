# Copy to .env (gitignored). All credentials are READ-ONLY tokens. Never commit real values.
# Validate your setup with: pch doctor

# --- Runtime profile -------------------------------------------------------
# dev | test | prod. In prod, config/scope.yaml must exist.
APP_ENV=dev

# --- Storage / paths -------------------------------------------------------
DATABASE_URL=sqlite:///data/pch.db
DATA_DIR=data
CONFIG_DIR=config

# --- Database ----------------------------------------------------------------
# SQLite (default), PostgreSQL:  postgresql+psycopg://user:pw@host:5432/db      (extra: postgres)
# Azure SQL / SQL Server:        mssql+pyodbc://user:pw@host:1433/db?driver=ODBC+Driver+18+for+SQL+Server   (extra: azuresql)
# Azure SQL with Entra ID (no password in the URL), set DB_AUTH=azure_ad:
#   DATABASE_URL=mssql+pyodbc://@myserver.database.windows.net:1433/mydb?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
# password = credentials are in DATABASE_URL (default); azure_ad = managed identity / DefaultAzureCredential token.
DB_AUTH=password
# Connection pool (server databases only). Recycle < Azure SQL's ~30 min idle disconnect.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
# Seconds to wait when opening a new server connection (psycopg connect_timeout / pyodbc login timeout).
DB_CONNECT_TIMEOUT_SECONDS=15
# Schema is managed by Alembic: run `pch db upgrade` as a deploy step. sqlite in dev/test migrates automatically.
# true = also migrate automatically at startup on any database (convenient, but concurrent instances may race
# and the app needs DDL rights; leave false in prod).
DB_AUTO_MIGRATE=false
# A scan lock / `running` scan older than this (minutes) is treated as abandoned (default 6 h).
# Must be larger than SCAN_TIMEOUT_MINUTES (startup refuses otherwise).
SCAN_LOCK_STALE_MINUTES=360

# --- Providers (see README "Providers") ----------------------------------------
# Where credentials come from. Providers are never mixed: with file / azure_keyvault the credential variables
# below (ADO_PAT, GITHUB_TOKEN, GITHUB_APP_PRIVATE_KEY, SONAR_TOKEN, AIKIDO_CLIENT_SECRET, SERVICENOW_PASSWORD) are ignored.
#   env            = the variables below (default). On App Service, Key Vault references arrive this way.
#   file           = one file per secret in SECRETS_DIR, named like the variable (SECRETS_DIR/ADO_PAT)
#   azure_keyvault = Azure Key Vault via managed identity / DefaultAzureCredential (extra: azure-keyvault);
#                    ADO_PAT is read from the vault secret "ado-pat"
SECRETS_PROVIDER=env
# SECRETS_DIR=/mnt/secrets
# KEYVAULT_URL=https://<vault-name>.vault.azure.net
# Optional JSON map env name -> vault secret name (default: lowercase, "_" -> "-"):
# KEYVAULT_SECRET_MAP={"ADO_PAT":"pch-ado-pat"}
# Seconds a Key Vault value is cached in memory (0 = always re-read).
# KEYVAULT_CACHE_TTL_SECONDS=300
# Where the redacted raw scan cache (for `pch scan --from-cache`) lives: local (DATA_DIR/raw) or azure_blob
# (extra: azure-blob; managed identity only, no account keys / SAS / connection strings).
ARTIFACT_STORE=local
# ARTIFACT_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
# ARTIFACT_BLOB_CONTAINER=pch-raw

# --- Azure DevOps (required for live scans) --------------------------------
ADO_ORG=<your-org>
ADO_PAT=
ADO_BASE_URL=https://dev.azure.com
ADO_VSRM_URL=https://vsrm.dev.azure.com

# --- GitHub (optional; read-only reader: org discovery, branch protection, file tree, CODEOWNERS) -------------
# GitHub.com: https://api.github.com   GitHub Enterprise Server: https://<host>/api/v3
GITHUB_API_URL=https://api.github.com
# pat = fine-grained personal access token (default); app = GitHub App installation (extra: github-app).
# The credential MUST be read-only: repository permissions Metadata: read, Contents: read, Actions: read, Environments: read,
# Deployments: read, Administration: read (Administration is only for classic branch protection; Actions/Environments/Deployments
# are for GitHub Actions workflows; without a permission that part is UNKNOWN, never FAIL).
GITHUB_AUTH=pat
GITHUB_TOKEN=
# GITHUB_AUTH=app only:
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=

# --- SonarQube (optional; set both URL and token) --------------------------
SONAR_URL=https://sonar.example.com
SONAR_TOKEN=

# --- Aikido (optional; set both client id and secret) ----------------------
AIKIDO_URL=https://app.aikido.dev
AIKIDO_CLIENT_ID=
AIKIDO_CLIENT_SECRET=

# --- ServiceNow (optional; set URL, user and password) ---------------------
SERVICENOW_URL=https://example.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# --- Collection tuning -----------------------------------------------------
# Parallel requests per source (1-64) and per-request timeout in seconds (>0, <=300).
CONCURRENCY=8
HTTP_TIMEOUT=30
# Largest single upstream response (MB). Bigger ones are aborted while streaming and recorded as a collection error.
HTTP_MAX_RESPONSE_MB=50

# --- Lineage tab and exports -----------------------------------------------
# Collect the last deployment per stage/environment (extra read-only ADO calls); false = stages show as unknown.
LINEAGE_ENABLED=true
# Deployments / environment records requested per lookup (10-1000).
LINEAGE_DEPLOYMENTS_TOP=200
# Largest CSV/Excel lineage export in rows; bigger exports are refused (HTTP 413).
EXPORT_MAX_ROWS=200000

# --- Web server ------------------------------------------------------------
# `pch serve` refuses to start unless the combination below is safe (see README "Security").
HOST=127.0.0.1
PORT=8000
# WEBSITES_PORT=8000            # App Service container port; used when PORT is not set
# Host header allowlist (comma separated, "*.example.com" wildcards ok). REQUIRED when APP_ENV=prod.
# ALLOWED_HOSTS=myapp.azurewebsites.net
# Proxy IPs trusted for X-Forwarded-*. "*" only on App Service (platform front end is the sole ingress).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Web authentication ----------------------------------------------------
# none: local development only (APP_ENV!=prod, loopback bind). easyauth: App Service Authentication (Entra ID) + app roles.
AUTH_MODE=none
# AUTH_ALLOWED_ROLES=PCH.Reader               # Entra app role value(s), comma separated (easyauth)
# AUTH_ALLOW_ANY_AUTHENTICATED=false          # explicit opt-in: any signed-in user when no role allowlist is set
# WEBSITE_AUTH_ENABLED is set by App Service itself when Authentication is on. Do not set it by hand.
# AUTH_EASYAUTH_ASSUME_ENABLED=false          # local testing of easyauth only; forbidden when APP_ENV=prod
# AUTH_NONE_ALLOW_CONTAINER_BIND=false        # dev only (docker compose): allow AUTH_MODE=none on 0.0.0.0

# --- Operations (see README "Operations") -------------------------------------
# text | json. Unset: json when APP_ENV=prod, else text. Secrets are scrubbed from every log line either way.
# LOG_FORMAT=json
LOG_LEVEL=INFO
# Seconds uvicorn waits for in-flight requests after SIGTERM / client keep-alive idle. # VERIFY: App Service waits ~30 s before SIGKILL.
GRACEFUL_SHUTDOWN_SECONDS=20
KEEP_ALIVE_SECONDS=65
# uvicorn's access log records full URLs; default: off in prod, on otherwise (the app writes its own request line).
# UVICORN_ACCESS_LOG=false
# /health/ready: DB probe time budget and result cache (seconds).
HEALTH_READY_TIMEOUT_SECONDS=2.5
HEALTH_READY_CACHE_SECONDS=5
# A scan longer than this is cancelled, marked failed (reason: timeout) and releases the scan lock.
SCAN_TIMEOUT_MINUTES=240
# Defaults for `pch scans prune` (empty = disabled): keep the newest N scans / delete scans older than D days (both = AND).
# RETENTION_KEEP_SCANS=30
# RETENTION_MAX_AGE_DAYS=90
# Optional Application Insights export (extra: azure-monitor). A secret: use a Key Vault reference on App Service.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# Sampling (read by the Azure Monitor distro): e.g. microsoft.fixed_percentage + 0.1, or microsoft.rate_limited + traces/second.
# OTEL_TRACES_SAMPLER=microsoft.fixed_percentage
# OTEL_TRACES_SAMPLER_ARG=0.1
