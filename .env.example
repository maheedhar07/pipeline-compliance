# Copy to .env (gitignored). All credentials are READ-ONLY tokens. Never commit real values.
# Validate your setup with: pch doctor

# --- Runtime profile -------------------------------------------------------
# dev | test | prod. In prod, config/scope.yaml must exist.
APP_ENV=dev

# --- Storage / paths -------------------------------------------------------
DATABASE_URL=sqlite:///data/pch.db
DATA_DIR=data
CONFIG_DIR=config

# --- Azure DevOps (required for live scans) --------------------------------
ADO_ORG=<your-org>
ADO_PAT=
ADO_BASE_URL=https://dev.azure.com
ADO_VSRM_URL=https://vsrm.dev.azure.com

# --- SonarQube (optional; set both URL and token) --------------------------
SONAR_URL=https://sonar.example.com
SONAR_TOKEN=

# --- Aikido (optional; set both client id and secret) ----------------------
AIKIDO_URL=https://app.aikido.dev
AIKIDO_CLIENT_ID=
AIKIDO_CLIENT_SECRET=

# --- ServiceNow (optional; set URL, user and password) ---------------------
SERVICENOW_URL=https://example.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# --- Collection tuning -----------------------------------------------------
# Parallel requests per source (1-64) and per-request timeout in seconds (>0, <=300).
CONCURRENCY=8
HTTP_TIMEOUT=30

# --- Web server ------------------------------------------------------------
# Keep loopback unless fronted by authentication (bind policy is enforced in a later milestone).
HOST=127.0.0.1
PORT=8000
